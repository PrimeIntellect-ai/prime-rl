{# Shared ModelExpress launch helper, included once per multi-node template inside the
   srun step. Trainer rank 0's node (SLURM_PROCID == NUM_INFER_NODES) starts a job-scoped
   server backed by its own Valkey; every node then waits until the server is reachable. #}
{% if uses_modelexpress_server -%}
{% if launch_modelexpress %}

    if [ "$SLURM_PROCID" -eq "$NUM_INFER_NODES" ]; then
        MX_BIN=$(uv run python -c 'import sysconfig; print(sysconfig.get_path("scripts"))')
        if [ ! -x "$MX_BIN/modelexpress-server" ] || [ ! -x "$MX_BIN/valkey-server" ]; then
            echo "modelexpress-server and valkey-server are missing in $MX_BIN; install the inference extra" >&2
            exit 1
        fi

        MX_STATE_DIR="$LOG_DIR/modelexpress"
        mkdir -p "$MX_STATE_DIR/cache"
        "$MX_BIN/valkey-server" \
            --port "$MODEL_EXPRESS_VALKEY_PORT" \
            --bind 127.0.0.1 \
            --protected-mode no \
            --save "" \
            --appendonly no \
            --dir "$MX_STATE_DIR" \
            > "$MX_STATE_DIR/valkey.log" 2>&1 &
        VALKEY_PID=$!
        trap '[ -z "${MODEL_EXPRESS_PID:-}" ] || kill -TERM "$MODEL_EXPRESS_PID" 2>/dev/null; kill -TERM "$VALKEY_PID" 2>/dev/null || true' EXIT

        for _ in $(seq 1 60); do
            timeout 1 bash -c "echo > /dev/tcp/127.0.0.1/$MODEL_EXPRESS_VALKEY_PORT" 2>/dev/null && break
            kill -0 "$VALKEY_PID" 2>/dev/null || {
                tail -50 "$MX_STATE_DIR/valkey.log" >&2
                exit 1
            }
            sleep 1
        done
        timeout 1 bash -c "echo > /dev/tcp/127.0.0.1/$MODEL_EXPRESS_VALKEY_PORT" 2>/dev/null || {
            echo "Valkey did not become ready on port $MODEL_EXPRESS_VALKEY_PORT" >&2
            exit 1
        }

        MX_METADATA_BACKEND=redis \
        REDIS_URL="redis://127.0.0.1:$MODEL_EXPRESS_VALKEY_PORT" \
        MX_HEARTBEAT_TIMEOUT_SECS=31536000 \
            "$MX_BIN/modelexpress-server" \
            --port "$MODEL_EXPRESS_PORT" \
            --metrics-port 0 \
            --cache-directory "$MX_STATE_DIR/cache" \
            > "$MX_STATE_DIR/server.log" 2>&1 &
        MODEL_EXPRESS_PID=$!
    fi
{% endif %}

    for _ in $(seq 1 120); do
        timeout 1 bash -c "echo > /dev/tcp/$WEIGHT_BROADCAST_HOST/$MODEL_EXPRESS_PORT" 2>/dev/null && break
        if [ -n "${MODEL_EXPRESS_PID:-}" ] && ! kill -0 "$MODEL_EXPRESS_PID" 2>/dev/null; then
            tail -50 "$MX_STATE_DIR/server.log" >&2
            exit 1
        fi
        sleep 1
    done
    timeout 1 bash -c "echo > /dev/tcp/$WEIGHT_BROADCAST_HOST/$MODEL_EXPRESS_PORT" 2>/dev/null || {
        echo "ModelExpress is not reachable at $WEIGHT_BROADCAST_HOST:$MODEL_EXPRESS_PORT" >&2
        exit 1
    }
{% endif %}
