{# Shared job-scoped Mooncake pool. Zero-capacity clients receive a connector
   configuration without starting a process that contributes storage. #}
{% set mc = namespace(disk_path="") %}
{% for offload in kv_offload_configs.values() if offload is not none and offload.type == "mooncake" %}
{% if offload.disk is not none %}{% set mc.disk_path = offload.disk.path | string %}{% endif %}
{% endfor %}
    MC_DIR="$OUTPUT_DIR/mooncake/node_${INFER_NODE_RANK}"
    mkdir -p "$MC_DIR"
    export PYTHONHASHSEED=0
    MC_HEAD=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -1)
    MC_MASTER="$MC_HEAD:50051"
    MC_METADATA="http://$MC_HEAD:8080/metadata"
    if [ "$INFER_NODE_RANK" -eq 0 ]; then
{% if mc.disk_path %}
        mkdir -p "{{ mc.disk_path }}"
{% endif %}
        mooncake_master -rpc_port=50051 -enable_http_metadata_server -http_metadata_server_host=0.0.0.0 -http_metadata_server_port=8080 -default_kv_lease_ttl=3600000{% if mc.disk_path %} -enable_offload=true -root_fs_dir={{ mc.disk_path }}{% endif %} > "$MC_DIR/master.log" 2>&1 &
    fi
    MC_ROLE=all
{% if is_disaggregated %}
    if (( INFER_NODE_RANK % ({{ num_prefill_nodes }} + {{ num_decode_nodes }}) < {{ num_prefill_nodes }} )); then
        MC_ROLE=prefill
    else
        MC_ROLE=decode
    fi
{% endif %}
{% for role, offload in kv_offload_configs.items() if offload is not none and offload.type == "mooncake" %}
    if [ "$MC_ROLE" = "{{ role }}" ]; then
        export MOONCAKE_CONFIG_PATH="$MC_DIR/config.json"
        for _ in $(seq 1 120); do timeout 1 bash -c "echo > /dev/tcp/$MC_HEAD/50051" 2>/dev/null && break; sleep 1; done
        for _ in $(seq 1 120); do timeout 1 bash -c "echo > /dev/tcp/$MC_HEAD/8080" 2>/dev/null && break; sleep 1; done
{% if offload.cpu.num_bytes > 0 %}
{% if offload.disk is not none %}
        mkdir -p "{{ offload.disk.path }}"
        export MOONCAKE_OFFLOAD_FSDIR="{{ offload.disk.path }}"
        export MOONCAKE_OFFLOAD_FILE_STORAGE_PATH="{{ offload.disk.path }}"
        export MOONCAKE_OFFLOAD_ENABLE_EVICTION=true
{% endif %}
        mooncake_client -host=$LOCAL_IP -port=50052 -master_server_address=$MC_MASTER -metadata_server=$MC_METADATA -protocol=rdma -global_segment_size={{ offload.cpu.num_bytes }}{% if offload.device_name %} -device_names={{ offload.device_name }}{% endif %}{% if offload.disk is not none %} -enable_offload=true{% endif %} > "$MC_DIR/client.log" 2>&1 &
        for _ in $(seq 1 60); do timeout 1 bash -c "echo > /dev/tcp/$LOCAL_IP/50052" 2>/dev/null && break; sleep 1; done
{% endif %}
        cat > "$MOONCAKE_CONFIG_PATH" <<MOONCAKE_JSON
{"mode":"standalone-store","global_segment_size":0,"local_buffer_size":{{ offload.local_buffer_bytes }},"protocol":"rdma","device_name":"{{ offload.device_name }}","master_server_address":"$MC_MASTER","metadata_server":"$MC_METADATA","enable_offload":{{ (offload.disk is not none) | tojson }}}
MOONCAKE_JSON
        echo "[mooncake] node $INFER_NODE_RANK role=$MC_ROLE master=$MC_MASTER contributed_bytes={{ offload.cpu.num_bytes }}"
    fi
{% endfor %}
