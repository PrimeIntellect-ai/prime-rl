{#- Mooncake distributed store (shared pool across inference nodes) for KV cache offload.
    One master + HTTP metadata server runs on the head inference node (first in the SLURM
    nodelist). Every node of a role with positive cpu.num_bytes runs a client that contributes its
    DRAM/SSD segment to that single pool; a role with cpu.num_bytes = 0 only connects to it. Any
    node can reuse prefixes cached by any other. Included by the SLURM templates inside the
    per-node body, so NO single quotes / apostrophes.
    Requires shell vars: LOCAL_IP, INFER_NODE_RANK, OUTPUT_DIR, NUM_PREFILL_NODES and
    NUM_DECODE_NODES under P/D (and SLURM env).
    Requires jinja vars: mooncake_offloads (role -> Mooncake offload config; role is prefill/decode
    under P/D, else all).
    Exports PYTHONHASHSEED + MOONCAKE_CONFIG_PATH for the vLLM process. (VLLM_RPC_BASE_PATH,
    used by the mooncake-store lookup ipc socket, is set per-rank in _launch_rank.sh.j2.) -#}
{%- set mc_disk_paths = mooncake_offloads.values() | selectattr("disk") | map(attribute="disk.path") | list %}
    # ---- Mooncake distributed store (shared pool across inference nodes) ----
    MC_DIR="$OUTPUT_DIR/mooncake/node_${INFER_NODE_RANK}"
    mkdir -p "$MC_DIR"
    export PYTHONHASHSEED=0
    export MOONCAKE_CONFIG_PATH="$MC_DIR/config.json"
    # The head inference node (first in the nodelist) hosts the one master + metadata server.
    MC_HEAD=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -1)
    MC_MASTER="$MC_HEAD:50051"
    MC_METADATA="http://$MC_HEAD:8080/metadata"
    if [ "$SLURMD_NODENAME" = "$MC_HEAD" ]; then
{%- if mc_disk_paths %}
        mkdir -p "{{ mc_disk_paths[0] }}"
        mooncake_master -rpc_port=50051 -enable_http_metadata_server -http_metadata_server_host=0.0.0.0 -http_metadata_server_port=8080 -default_kv_lease_ttl=3600000 -enable_offload=true -root_fs_dir={{ mc_disk_paths[0] }} > "$MC_DIR/master.log" 2>&1 &
{%- else %}
        # default_kv_lease_ttl raised from 5s: KV blocks were expiring before the decode side
        # reused them ("invalid KV blocks ... may have expired"), the real non-NIC config issue.
        mooncake_master -rpc_port=50051 -enable_http_metadata_server -http_metadata_server_host=0.0.0.0 -http_metadata_server_port=8080 -default_kv_lease_ttl=3600000 > "$MC_DIR/master.log" 2>&1 &
{%- endif %}
    fi
{%- if is_disaggregated %}
    if (( INFER_NODE_RANK % (NUM_PREFILL_NODES + NUM_DECODE_NODES) < NUM_PREFILL_NODES )); then MC_ROLE=prefill; else MC_ROLE=decode; fi
{%- else %}
    MC_ROLE=all
{%- endif %}
{%- for role, offload in mooncake_offloads.items() %}
    if [ "$MC_ROLE" = "{{ role }}" ]; then
        # Wait for the shared master + metadata, then contribute this node's segment (if any).
        for _ in $(seq 1 120); do timeout 1 bash -c "echo > /dev/tcp/$MC_HEAD/50051" 2>/dev/null && break; sleep 1; done
        for _ in $(seq 1 120); do timeout 1 bash -c "echo > /dev/tcp/$MC_HEAD/8080" 2>/dev/null && break; sleep 1; done
{%- if offload.cpu.num_bytes > 0 %}
{%- if offload.disk %}
        mkdir -p "{{ offload.disk.path }}"
        export MOONCAKE_OFFLOAD_FSDIR="{{ offload.disk.path }}"
        export MOONCAKE_OFFLOAD_FILE_STORAGE_PATH="{{ offload.disk.path }}"
        export MOONCAKE_OFFLOAD_ENABLE_EVICTION=true
{%- endif %}
        mooncake_client -host=$LOCAL_IP -port=50052 -master_server_address=$MC_MASTER -metadata_server=$MC_METADATA -protocol=rdma -global_segment_size={{ offload.cpu.num_bytes }}{% if offload.device_name %} -device_names={{ offload.device_name }}{% endif %}{% if offload.disk %} -enable_offload=true{% endif %} > "$MC_DIR/client.log" 2>&1 &
        for _ in $(seq 1 60); do timeout 1 bash -c "echo > /dev/tcp/$LOCAL_IP/50052" 2>/dev/null && break; sleep 1; done
{%- endif %}
        cat > "$MOONCAKE_CONFIG_PATH" <<MOONCAKE_JSON
{"mode":"standalone-store","global_segment_size":0,"local_buffer_size":4294967296,"protocol":"rdma","device_name":"{{ offload.device_name }}","master_server_address":"$MC_MASTER","metadata_server":"$MC_METADATA","enable_offload":{{ "true" if offload.disk else "false" }}}
MOONCAKE_JSON
        echo "[mooncake] node ${INFER_NODE_RANK} ($SLURMD_NODENAME) role=$MC_ROLE joined shared pool: master=$MC_MASTER contributed_bytes={{ offload.cpu.num_bytes }}"
    fi
{%- endfor %}
