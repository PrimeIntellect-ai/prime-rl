#!/bin/bash

#SBATCH --job-name={{ job_name }}-eval
#SBATCH --nodes={{ num_infer_nodes }}
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:{{ gpus_per_node }}
#SBATCH --partition={{ partition }}
{%- if account %}
#SBATCH --account={{ account }}
{%- endif %}
{%- if time %}
#SBATCH --time={{ time }}
{%- endif %}
{%- if nodelist %}
#SBATCH --nodelist={{ nodelist }}
{%- endif %}
{%- if exclude %}
#SBATCH --exclude={{ exclude }}
{%- endif %}
#SBATCH --exclusive
#SBATCH --output={{ output_dir }}/eval_job_%j.log
#SBATCH --error={{ output_dir }}/eval_job_%j.log

# Online-eval job for a decoupled SFT run: the inference pool (one vLLM engine per
# DP rank behind a single router) plus the evals process and its env servers. The trainer
# runs in a separate SLURM job and hands weights over via checkpoints on the shared
# filesystem, so this job outlives the trainer and exits after evaluating the final
# checkpoint (max_steps).

# Exit immediately on any failed command so a crash anywhere releases the
# allocation instead of leaving zombie processes holding nodes.
set -e

# Configs
export NUM_NODES={{ num_infer_nodes }}
export GPUS_PER_NODE={{ gpus_per_node }}
export ROUTER_PORT={{ router_port }}
export BACKEND_PORT={{ backend_port }}
export RPC_PORT={{ data_parallel_rpc_port }}

# Paths
export PROJECT_DIR={{ project_dir }}
export CONFIG_DIR={{ config_dir }}
export CONFIG_PATH=$CONFIG_DIR/inference.json
export OUTPUT_DIR={{ output_dir }}
# Move a previous job's inference logs aside instead of deleting them: rm of log
# files another job's processes still hold open can wedge in the NFS client and
# hang the whole job before srun even runs.
[ -d $OUTPUT_DIR/logs/inference ] && mv $OUTPUT_DIR/logs/inference $OUTPUT_DIR/logs/inference_prev_$(date +%s)
mkdir -p $OUTPUT_DIR/logs/inference
ln -sfn inference/node_0.log $OUTPUT_DIR/logs/inference.log

# A clean evals exit cannot trip srun --kill-on-bad-exit (which only propagates
# failures), so node 0 publishes completion through this job-scoped sentinel and the
# other nodes watch for it to release their engines. Stale sentinels from other job
# IDs are inert, so only this job's own path needs clearing.
export EVAL_DONE=$OUTPUT_DIR/.eval_done_$SLURM_JOB_ID
rm -f "$EVAL_DONE"
{% if prl_run_id %}
# Trainer (separate SLURM job) and evals log to a single shared W&B run whose id
# ($WANDB_RUN_ID) equals $PRL_RUN_ID: the trainer creates it, the evals process (which
# outlives the trainer) finalizes it.
export PRL_RUN_ID={{ prl_run_id }}
export PRL_RUN_NAME={{ run_name }}
export WANDB_RUN_ID=$PRL_RUN_ID
export WANDB_SHARED_MODE=1
export WANDB_SHARED_PRIMARY=trainer
export WANDB_SHARED_FINISHER=evals
export WANDB_PROGRAM="uv run sft"
{% endif %}
# Networking
export HOSTNAMES=( $( scontrol show hostnames $SLURM_JOB_NODELIST ) )
export HOSTNAMES_STR="${HOSTNAMES[*]}"

# Single global router on node 0 fronts every per-rank endpoint; admin ops
# (pause/update_weights/resume) bypass it and hit each rank directly.
INFER_URLS="http://${HOSTNAMES[0]}:${ROUTER_PORT}/v1"
DP_PER_NODE={{ dp_per_node }}
ADMIN_URLS=""
ROUTER_ARGS=""
for host in ${HOSTNAMES[@]}; do
    for ((d=0; d<DP_PER_NODE; d++)); do
        ADMIN_URLS="${ADMIN_URLS:+$ADMIN_URLS }http://${host}:$((BACKEND_PORT + d))/v1"
        ROUTER_ARGS="$ROUTER_ARGS http://${host}:$((BACKEND_PORT + d))"
    done
done
export INFER_URLS
export ADMIN_URLS
export ROUTER_ARGS
echo "HOSTNAMES=${HOSTNAMES[@]}"
echo "INFER_URLS=${INFER_URLS}"
echo "ADMIN_URLS=${ADMIN_URLS}"

# Setup environment
cd $PROJECT_DIR
[ -f .env ] && source .env
source .venv/bin/activate
{% if not shared_fs %}
# Node-local venv (e.g. UV_PROJECT_ENVIRONMENT on /tmp): a bare `uv sync` would only
# build the batch node, so srun runs it on every node (one task each) and blocks until
# all finish. `set -e` above aborts the job if any node's sync fails. Re-source .env
# inside the task because unexported vars in .env don't cross srun even with normal
# SLURM env propagation; otherwise uv would silently fall back to the shared .venv.
srun --ntasks-per-node=1 bash -s <<'SYNC_SH'
cd $PROJECT_DIR && { [ -f .env ] && source .env || true; } && uv sync --all-extras --all-packages
SYNC_SH
{% else %}
# Shared (NFS) venv: one sync on the batch node populates it for all nodes.
uv sync --all-extras --all-packages
{% endif %}

{% if pre_run_command %}
# Pre-run command
{{ pre_run_command }}
{% endif %}

# Cleanup stale node-local state from prior jobs. Orphan python/vllm processes and
# vLLM/torch IPC files under /dev/shm and /tmp can survive SLURM termination and
# cause the next launch to hang. Harmless on clean nodes.
#
# `bash -s` with a heredoc on stdin keeps the script body out of every bash
# / srun argv — otherwise `pkill -f "[v]llm"` self-matches the cleanup procs
# because the surviving literal `vllm` strings below appear in the cmdline.
srun bash -s <<'CLEANUP_SH'
    pkill -9 -f "[p]ython.*prime_rl" 2>/dev/null
    pkill -9 -f "[v]llm-router" 2>/dev/null
    pkill -9 -f "[v]llm" 2>/dev/null
    pkill -9 -f "[p]rime_rl" 2>/dev/null
    # Also match prctl-set process names (kernel comm) like "vllm::router"
    # which pkill -f does not see because -f only matches the cmdline.
    pkill -9 "vllm" 2>/dev/null
    pkill -9 "vllm::.*" 2>/dev/null
    sleep 2
    rm -rf /dev/shm/vllm-* /dev/shm/vllm_* /tmp/vllm-* /tmp/vllm_* /tmp/torch-* 2>/dev/null
    procs=$(ps -eo comm,args | grep -E "python|vllm|vllm::" | grep -v grep | wc -l)
    gpu=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | awk "{s+=\$1} END {print s}")
    echo "[node-cleanup] $(hostname) procs=$procs gpu_mem=${gpu}MiB"
CLEANUP_SH

# Run the eval deployment
# --kill-on-bad-exit=1 propagates a non-zero exit on any node to all other
# tasks so a crashed engine/router/evals terminates the SLURM job instead
# of leaving the surviving ranks holding nodes.
#
# The body goes to bash on stdin through a quoted heredoc instead of a
# single-quoted `bash -c` argument: srun broadcasts stdin to every task, and the
# quoted delimiter passes the script through verbatim, so apostrophes and quotes
# (including in the shared _launch_*.sh.j2 includes) need no escaping. Nothing in
# the body reads stdin, which would otherwise eat the rest of the script.
srun --kill-on-bad-exit=1 bash -s <<'LAUNCH_SH'
    # pipefail ensures `cmd | tee log` propagates `cmd` failures, and the
    # wait/cleanup block at the end of this script surfaces background
    # process crashes (router, engines) as task failures.
    set -o pipefail

    cd $PROJECT_DIR
    [ -f .env ] && source .env
    source .venv/bin/activate

    # Higher ulimit
    ulimit -n 65536

    # Infiniband setup
    IB_HCA=$(ibv_devinfo 2>/dev/null | sed -n -e "/hca_id/p" -e "/link_layer:/p" | grep -B1 InfiniBand | grep hca_id | sed -e "s/^hca_id://g" | tr -d "[[:blank:]]" | paste -sd,)
    [ -n "$IB_HCA" ] && export NCCL_IB_HCA=$IB_HCA

    INFER_NODE_RANK=$SLURM_PROCID
    LOCAL_IP=$(hostname -I | awk "{print \$1}")
    # Inference env vars: launcher defaults + [env_vars] + [inference.env_vars]
{%- for key, value in inference_env_vars.items() %}
    export {{ key }}="{{ value }}"
{%- endfor %}

{% include '_launch_rank.sh.j2' %}
{% include '_launch_router.sh.j2' %}

    echo "INFER_NODE_RANK=${INFER_NODE_RANK}, LOCAL_IP=${LOCAL_IP}" \
        | tee $OUTPUT_DIR/logs/inference/node_${INFER_NODE_RANK}.log

    DP_PER_NODE={{ dp_per_node }}
    TP=$((GPUS_PER_NODE / DP_PER_NODE))
    EP={{ "1" if enable_expert_parallel else "0" }}

    # External-LB: one vLLM API server per DP rank on this node (BACKEND_PORT + dp_local),
    # each pinned to its TP slice of GPUs. Each node is an independent replica, so any MoE EP
    # group is node-local (rendezvous on LOCAL_IP); dense models run independent engines.
    for ((d=0; d<DP_PER_NODE; d++)); do
        RANK_GPUS=$(seq -s, $((d * TP)) $((d * TP + TP - 1)))
        RANK_LOG=$(rank_log "$INFER_NODE_RANK" "$d")
        if [ "$EP" -eq 1 ] && [ "$DP_PER_NODE" -gt 1 ]; then
            RANK_EXTRA="{\"data_parallel_rank\": $d, \"data_parallel_address\": \"$LOCAL_IP\"}"
            launch_inference_rank "$((BACKEND_PORT + d))" "$RANK_GPUS" "$DP_PER_NODE" "$RPC_PORT" "$RANK_EXTRA" "" "$RANK_LOG"
        else
            # Dense or single-DP-rank EP (dp=1, e.g. EP within one tp=8 group):
            # independent single-engine servers. vLLM rejects the external-LB DP
            # args when data_parallel_size == 1; enable_expert_parallel in the
            # inference config alone shards experts across the TP group.
            launch_inference_rank "$((BACKEND_PORT + d))" "$RANK_GPUS" 1 "" "" "" "$RANK_LOG"
        fi
    done

    if [ "$INFER_NODE_RANK" -eq 0 ]; then
        # Single global router on node 0 (external LB across all per-rank endpoints)
        launch_router regular "$ROUTER_ARGS" "$ROUTER_PORT" "{{ router.policy }}" "$OUTPUT_DIR/logs/inference/router.log"
{%- if eval_env_names %}

        # One env server per eval source next to the evals process, which connects to each
        # source at its deterministic loopback address (so this node), polling until
        # they are up - the servers and the evals process start in parallel.
{%- for name in eval_env_names %}
        mkdir -p $OUTPUT_DIR/logs/envs/eval
        uv run env-server @ $CONFIG_DIR/envs/eval/{{ name }}.json \
            > $OUTPUT_DIR/logs/envs/eval/{{ name }}.log 2>&1 &
{%- endfor %}
{%- endif %}

        # The evals process watches the trainer's weights dir on the shared filesystem and
        # drives the pool: data plane through the router, admin ops per rank.
{%- for key, value in evals_env_vars.items() %}
        export {{ key }}="{{ value }}"
{%- endfor %}
        WANDB_SHARED_LABEL=evals uv run evals \
            @ $CONFIG_DIR/evals.json \
            --eval.client.base-url $INFER_URLS \
            --eval.client.admin-base-url $ADMIN_URLS \
            2>&1 | tee $OUTPUT_DIR/logs/evals.log &
        EVALS_PID=$!
    else
        # Watch for the completion sentinel so this node's wait below returns when
        # the evals process (on node 0) finishes cleanly.
        ( until [ -f "$EVAL_DONE" ]; do sleep 10; done ) &
    fi

# Wait for the first background job to exit and propagate its exit code. This
# turns background process crashes (engines, router, env servers, evals)
# into task failures that --kill-on-bad-exit=1 can broadcast to the other nodes
# so the whole job tears down instead of leaving zombies holding the allocation.
wait -n -p FINISHED_PID
EXIT_CODE=$?
if [ "${FINISHED_PID:-}" = "${EVALS_PID:-none}" ]; then
    # Publish completion so the sentinel watchers on the other nodes release too
    # (a zero exit here never trips --kill-on-bad-exit).
    touch "$EVAL_DONE"
fi
echo "[$(hostname)] component exited with code $EXIT_CODE - terminating remaining processes"
for pid in $(jobs -p); do
    kill -TERM $pid 2>/dev/null || true
done
exit $EXIT_CODE
LAUNCH_SH
