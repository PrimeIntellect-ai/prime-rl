#!/bin/bash

#SBATCH --job-name={{ job_name }}
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:{{ gpus_per_node }}
#SBATCH --exclusive
#SBATCH --partition={{ partition }}
{%- if account %}
#SBATCH --account={{ account }}
{%- endif %}
{%- if time %}
#SBATCH --time={{ time }}
{%- endif %}
{%- if nodelist %}
#SBATCH --nodelist={{ nodelist }}
{%- endif %}
{%- if exclude %}
#SBATCH --exclude={{ exclude }}
{%- endif %}
#SBATCH --output={{ launcher_log_dir }}/job_%j.log
#SBATCH --error={{ launcher_log_dir }}/job_%j.log

# Exit immediately if any setup command or the launcher fails so the SLURM job
# releases its allocation instead of holding nodes after a crash.
set -e

export PROJECT_DIR={{ project_dir }}
export PRL_ATTEMPT_CONFIG_DIR={{ config_dir }}
export PRL_ATTEMPT_LOG_DIR={{ log_dir }}

# Setup environment
cd $PROJECT_DIR
[ -f .env ] && source .env
source .venv/bin/activate
{% if skip_dependency_sync %}
# Keep the prepared environment unchanged, including deployment-installed packages.
export UV_NO_SYNC=1
{% else %}
uv sync --all-extras --all-packages
{% endif %}

{% if pre_run_command %}
# Pre-run command
{{ pre_run_command }}
{% endif %}
uv run sft @ {{ config_path }}
