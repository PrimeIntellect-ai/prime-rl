+def _parse_score_head(
+    choice: Mapping[str, Any], score_topk: int
+) -> list[tuple[list[int], list[float]]]:
+    score_head = []
+    for row in choice["logprobs"]["content"]:
+        head = sorted(
+            row["top_logprobs"], key=lambda item: item["logprob"], reverse=True
+        )[:score_topk]
+        if len(head) != score_topk:
+            raise MalformedGenerateResponseError(
+                "Incomplete score-centering top-k logprobs"
+            )
+        ids = [int(item["token"].removeprefix("token_id:")) for item in head]
+        values = [float(item["logprob"]) for item in head]
+        if len(set(ids)) != len(ids) or not all(
+            math.isfinite(x) and x <= 0 for x in values
+        ):
+            raise MalformedGenerateResponseError(
+                "Invalid score-centering top-k logprobs"
+            )
+        score_head.append((ids, values))
+    return score_head
