+@pytest.mark.parametrize("compact", [False, True])
+def test_generate_score_head_transport(monkeypatch, compact):
+    monkeypatch.setenv("PRL_SCORE_TOPK", "1")
+    if compact:
+        monkeypatch.delenv("PRL_COMPACT_LOGPROBS", raising=False)
+    else:
+        monkeypatch.setenv("PRL_COMPACT_LOGPROBS", "0")
+    client = _FakeClient()
+    values = np.asarray([-0.1, -1.0, -0.2, -1.0], dtype="<f4")
+    if compact:
+        ids = np.asarray([7, 2, 8, 2], dtype="<u4")
+        client.choice["logprobs"] = None
+        client.choice["compact_logprobs"] = {
+            "data": base64.b64encode(ids.tobytes() + values.tobytes()).decode(),
+            "format": "u32-f32-le-v1",
+            "offsets": [0, 2, 4],
+            "num_top_logprobs": 2,
+        }
+    else:
+        for i, row in enumerate(client.choice["logprobs"]["content"]):
+            row["logprob"] = float(values[2 * i])
+            row["top_logprobs"] = [
+                {"token": row["token"], "logprob": row["logprob"]},
+                {"token": "token_id:2", "logprob": -1.0},
+            ]
+    result = _run_generate(client)
+    assert result["completion_logprobs"] == values[::2].tolist()
+    assert result["score_head"] == [
+        ([7], [float(values[0])]),
+        ([8], [float(values[2])]),
+    ]
+    params = client.calls[0]["body"]["sampling_params"]
+    assert params["logprobs"] == 2
+    assert params.get("extra_args", {}).get("prl_compact_logprobs", False) is compact
+    assert isinstance(result["routed_experts"]["data"], memoryview)
